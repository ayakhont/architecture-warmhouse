@startuml
entity "User" as user {
  *id : int
  --
  name : string
  email : string
}

entity "House" as house {
  *id : int
  --
  address : string
  user_id : int
}

entity "Device" as device {
  *id : int
  type_id : int
  house_id : int
  --
  name : string
  serial_number: string
  firmware_version: string
}

entity "DeviceType" as devicetype {
  *id : int
  name : string
  description : string
}

entity "Module" as module {
  *id : int
  device_id : int
  name : string
  version : string
}

entity "Telemetry" as telemetry {
  *id : int
  device_id : int
  timestamp : datetime
  value : float
}

entity "Payment" as payment {
  *id : int
  user_id : int
  amount : float
  status : string
  created_at : datetime
}

entity "MarketplaceItem" as item {
  *id : int
  name : string
  price : float
  description : string
}

entity "AutomationScenario" as scenario {
  *id : int
  user_id : int
  name : string
  config : text
}

user ||--o{ house : owns
house ||--o{ device : contains
devicetype ||--o{ device : classifies
device ||--o{ module : has
device ||--o{ telemetry : sends
user ||--o{ payment : makes
user ||--o{ scenario : configures
item ||--o{ payment : purchased_by

@enduml